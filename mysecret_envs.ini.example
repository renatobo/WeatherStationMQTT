; Copy to mysecret_envs.ini. Leave targets unset for compile-only use.
; Set each upload_port only after verifying the intended device.
[security:office]
ota_password = EXAMPLE_OTA_OFFICE_DO_NOT_DEPLOY
provisioning_password = EXAMPLE_AP_OFFICE_DO_NOT_DEPLOY

[security:workshop]
ota_password = EXAMPLE_OTA_WORKSHOP_DO_NOT_DEPLOY
provisioning_password = EXAMPLE_AP_WORKSHOP_DO_NOT_DEPLOY

[security:Printer3d]
ota_password = EXAMPLE_OTA_PRINTER_DO_NOT_DEPLOY
provisioning_password = EXAMPLE_AP_PRINTER_DO_NOT_DEPLOY

[env:office_ota]
; upload_port = office-device.local

[env:workshop_ota]
; upload_port = workshop-device.local

[env:Printer3d_ota]
; upload_port = printer-device.local
